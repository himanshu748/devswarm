HF_TOKEN=hf_your_token_here
# OTLP HTTP endpoint of your SigNoz collector, e.g. http://localhost:4318
SIGNOZ_OTLP_ENDPOINT=
# SigNoz UI base + a PAT from Settings > API keys; enables auto-provisioned per-app dashboards
SIGNOZ_URL=http://localhost:8080
SIGNOZ_API_TOKEN=
# Local development only. A non-loopback host exposes unauthenticated APIs.
HOST=127.0.0.1
PORT=4100
# Swarm Doctor trace queries: docker exec into this container by default,
# or set CLICKHOUSE_HTTP_URL (e.g. http://localhost:8123) to skip Docker entirely
SIGNOZ_CLICKHOUSE_CONTAINER=signoz-telemetrystore-clickhouse-0-0
CLICKHOUSE_HTTP_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Positive minutes a fallback promotion stays pinned before the primary is retried.
# Missing, empty, zero, negative, non-finite and overflowing values use 10 minutes.
FALLBACK_TTL_MINUTES=10
# Live previews spawn generated backends on ports counting up from here
PREVIEW_PORT_BASE=4300
